#
# Корневой .env читает только фронт (CRA, REACT_APP_*).
# Бэкенд читает свой backend/.env — см. backend/.env.example.
#
# Если используешь WebStorm, после правки .env иногда нужен перезапуск самой IDE,
# а не только dev-сервера, чтобы значения подхватились.
#
# https://smartapp-studio.sberdevices.ru/ -> Профиль -> Настройки профиля -> Auth Token
#

REACT_APP_TOKEN=""
REACT_APP_SMARTAPP=""
REACT_APP_BACKEND_URL=http://localhost:8000
#BROWSER=none
#GENERATE_SOURCEMAP=false
