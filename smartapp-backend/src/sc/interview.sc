theme: /

    # --- выбор темы ---
    # Ординалы («первый», «1») сюда не кладём: на экране welcome порядковый
    # выбор обрабатывает item_selector с фронта. Иначе в квизе фраза «первый»
    # совпала бы и с ТемойPython, и с Вариантом1.

    state: ТемаPython
        q!: (выбери|давай|хочу|начни|запусти|начать|поехали|проверь меня) [~интервью|~квиз|~тему|~раздел|~опрос] [по] (питон|python|пайтон|питону|пайтону|питоне|пайтоне)
        q!: (тема|раздел|интервью|квиз|опрос) [по] (питон|python|пайтон|питону|пайтону)
        q!: (питон|python|пайтон|питону|пайтону)
        q!: расскажи [про|о|об] (питон|python|пайтон|питоне|пайтоне)
        script:
            log('quiz: ТемаPython')
            chooseTopic("python", $context)

    state: ТемаClassicalML
        q!: (выбери|давай|хочу|начни|запусти|начать|поехали|проверь меня) [~интервью|~квиз|~тему|~раздел|~опрос] [по] (классический ml|classical ml|классическое мл|классический мл|классическое машинное обучение|классическому ml|классическому мл|машинное обучение|машинному обучению)
        q!: (тема|раздел|интервью|квиз|опрос) [по] (классическому ml|классическому мл|классический ml|классический мл|машинному обучению|машинное обучение)
        q!: (классический ml|classical ml|классический мл|классическое мл|машинное обучение|классическое машинное обучение)
        q!: расскажи [про|о|об] (классический ml|классическое мл|машинное обучение|машинном обучении)
        script:
            log('quiz: ТемаClassicalML')
            chooseTopic("classical_ml", $context)

    state: ТемаDeepLearning
        q!: (выбери|давай|хочу|начни|запусти|начать|поехали|проверь меня) [~интервью|~квиз|~тему|~раздел|~опрос] [по] (deep learning|дип лёрнинг|дип лернинг|глубокое обучение|глубокому обучению|нейросети|нейронные сети|нейросетям|нейронным сетям)
        q!: (тема|раздел|интервью|квиз|опрос) [по] (deep learning|дип лёрнинг|глубокому обучению|нейросетям|нейронным сетям)
        q!: (deep learning|дип лёрнинг|дип лернинг|глубокое обучение|нейросети|нейронные сети)
        q!: расскажи [про|о|об] (deep learning|дип лёрнинге|глубоком обучении|нейросетях)
        script:
            log('quiz: ТемаDeepLearning')
            chooseTopic("deep_learning", $context)

    state: ТемаNLPCV
        q!: (выбери|давай|хочу|начни|запусти|начать|поехали|проверь меня) [~интервью|~квиз|~тему|~раздел|~опрос] [по] (nlp|нлп|обработка текста|обработке текста|обработка естественного языка|компьютерное зрение|компьютерному зрению|computer vision|nlp и cv|нлп и cv|нлп и компьютерное зрение)
        q!: (тема|раздел|интервью|квиз|опрос) [по] (nlp|нлп|computer vision|компьютерному зрению|обработке текста|nlp и cv|нлп и cv)
        q!: (nlp|нлп|обработка текста|computer vision|компьютерное зрение|nlp и cv|нлп и cv)
        q!: расскажи [про|о|об] (nlp|нлп|computer vision|компьютерном зрении|обработке текста)
        script:
            log('quiz: ТемаNLPCV')
            chooseTopic("nlp_cv", $context)

    # --- выбор длины ---
    # Голые числа («5», «пять») сюда не кладём — иначе на экране квиза
    # совпали бы с ответами. Требуем якорь («вопрос», «коротко» и т.п.).

    state: Длина5
        q!: (пять|5) ~вопрос
        q!: (короткий|коротко|быстро|мини|маленький) [~квиз|~интервью|~опрос]
        q!: (давай|возьми|хочу|пройду) (пять|5) [~вопрос]
        script:
            log('quiz: Длина5')
            chooseLength(5, $context)

    state: Длина10
        q!: (десять|10) ~вопрос
        q!: (средний|средне|нормально|обычный|стандартный) [~квиз|~интервью|~опрос]
        q!: (давай|возьми|хочу|пройду) (десять|10) [~вопрос]
        script:
            log('quiz: Длина10')
            chooseLength(10, $context)

    state: Длина20
        q!: (двадцать|20) ~вопрос
        q!: (длинный|длинно|подольше|долгий|большой) [~квиз|~интервью|~опрос]
        q!: (давай|возьми|хочу|пройду) (двадцать|20) [~вопрос]
        script:
            log('quiz: Длина20')
            chooseLength(20, $context)

    state: ДлинаВесьБанк
        q!: (весь банк|все вопросы|целиком|максимум|полный|полностью|весь объём)
        q!: (давай|хочу|пройду) (всё|все|весь банк|все вопросы)
        script:
            log('quiz: ДлинаВесьБанк')
            chooseLength("all", $context)

    # --- выбор варианта ответа ---

    state: Вариант1
        q!: (первый|первая|первое|номер один|вариант один|вариант первый|1) [~ответ]
        q!: (отвечаю|отвечу|выбираю|думаю|скажу) (первый|первое|один|1)
        q!: ответ (один|первый|1)
        script:
            log('quiz: Вариант1')
            pickOption(0, $context)

    state: Вариант2
        q!: (второй|вторая|второе|номер два|вариант два|вариант второй|2) [~ответ]
        q!: (отвечаю|отвечу|выбираю|думаю|скажу) (второй|второе|два|2)
        q!: ответ (два|второй|2)
        script:
            log('quiz: Вариант2')
            pickOption(1, $context)

    state: Вариант3
        q!: (третий|третья|третье|номер три|вариант три|вариант третий|3) [~ответ]
        q!: (отвечаю|отвечу|выбираю|думаю|скажу) (третий|третье|три|3)
        q!: ответ (три|третий|3)
        script:
            log('quiz: Вариант3')
            pickOption(2, $context)

    state: Вариант4
        q!: (четвёртый|четвёртая|четвёртое|номер четыре|вариант четыре|вариант четвёртый|4) [~ответ]
        q!: (отвечаю|отвечу|выбираю|думаю|скажу) (четвёртый|четвёртое|четыре|4)
        q!: ответ (четыре|четвёртый|4)
        script:
            log('quiz: Вариант4')
            pickOption(3, $context)

    # --- управление прохождением ---

    state: НеЗнаю
        q!: (не знаю|понятия не имею|без понятия|пропусти|пропустить|пас|сдаюсь|без идей|затрудняюсь)
        script:
            log('quiz: НеЗнаю')
            dontKnow($context)

    state: СледующийВопрос
        q!: (~следующий ~вопрос|дальше|продолжай|продолжим|вперёд|едем дальше|поехали дальше|давай дальше)
        script:
            log('quiz: СледующийВопрос')
            nextQuestion($context)

    state: ЗакончитьКвиз
        q!: (закончи|закончим|закончить|хватит|стоп|конец|завершить|выход|выйти|остановим|остановись|закончим тему|закончить тему)
        script:
            log('quiz: ЗакончитьКвиз')
            finishQuiz($context)

    state: ЕщёТему
        q!: (ещё одну тему|пройти ещё тему|ещё тему|давай ещё|следующая тема|новая тема|ещё раз|другую тему|сменим тему)
        q!: (начать заново|заново|сначала|по новой|с начала|перезапусти)
        script:
            log('quiz: ЕщёТему')
            startAgain($context)

    # --- TTS-озвучка от фронта ---

    state: Озвучить
        event!: SPEAK
        script:
            log('quiz: Озвучить: context: ' + JSON.stringify($context))
            var eventData = $context && $context.request && $context.request.data && $context.request.data.eventData || {}
            log('quiz: Озвучить: eventData: ' + JSON.stringify(eventData))
            $reactions.answer({
                "value": eventData.text
            })
